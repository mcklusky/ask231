VITE_API_URL=http://127.0.0.1:8000/api
# Public address of the site, used for link-preview tags in index.html and the "get the app" QR code (e.g. https://ask231.com).
VITE_SITE_URL=http://127.0.0.1:5173
# MarketDay's own social pages (https:// links). Leave empty to hide an icon.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_YOUTUBE_URL=
# WhatsApp channel or community invite link; also shows a "Join on WhatsApp" card on the home page.
VITE_WHATSAPP_CHANNEL_URL=
# Country and brand (defaults shown: ask + 231 = ask231, Liberia). Change these to launch in another country;
# keep them in step with the backend's COUNTRY_CALLING_CODE, COUNTRY_NAME, DEFAULT_CURRENCY and BRAND_WORD.
# VITE_BRAND_WORD=ask
# VITE_COUNTRY_CODE=231
# VITE_COUNTRY_NAME=Liberia
# VITE_COUNTRY_ADJECTIVE=Liberian
# VITE_COUNTRY_ISO=LR
# VITE_CURRENCY=LRD
# VITE_CURRENCY_SYMBOL=L$
# VITE_CURRENCY_NAME=Liberian dollar
