# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.

# The site's address, without https://. Before you have a domain, use the server's static IP
# with dashes + .sslip.io, e.g. 3-14-15-92.sslip.io (HTTPS still works).
DOMAIN=ask231.com

# Django. Make the secret with:  openssl rand -base64 48
DJANGO_SECRET_KEY=
# Keep 127.0.0.1: the container health check uses it.
ALLOWED_HOSTS=ask231.com,127.0.0.1
FRONTEND_URL=https://ask231.com
CSRF_TRUSTED_ORIGINS=https://ask231.com
CORS_ALLOWED_ORIGINS=https://ask231.com

# Database (created automatically on first start).
# Use letters and numbers only:  openssl rand -hex 24
DB_NAME=ask231
DB_USER=ask231
DB_PASSWORD=

# Email: until this is set up, verification and password-reset emails are only printed in the logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Text messages: "console" only prints them in the logs; "twilio" sends them.
SMS_BACKEND=console
SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: auto-post approved ads to the Facebook page.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# Optional: social links shown in the site footer (full https:// addresses). Rebuild after changing.
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_YOUTUBE_URL=
VITE_WHATSAPP_CHANNEL_URL=
