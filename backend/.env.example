DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Email. Local development prints emails to the console. Production sends through Brevo:
#   EMAIL_BACKEND=accounts.brevo.BrevoEmailBackend and BREVO_API_KEY=<your key> (never commit the real key)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
DEFAULT_FROM_EMAIL=no-reply@ask231.com
EMAIL_FROM_NAME=Ask231
# How long an email verification link works.
EMAIL_VERIFICATION_HOURS=24
# Old SMTP settings (only used when EMAIL_BACKEND is the SMTP backend).
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=
AWS_MEDIA_CLOUDFRONT_DOMAIN=
DB_HOST=
DB_NAME=marketday
DB_USER=marketday
DB_PASSWORD=
DB_PORT=5432
DB_SSLMODE=require
TRUST_X_FORWARDED_PROTO=False
